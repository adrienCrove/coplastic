<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Action rapport Bon de Commande
    ========================================================= -->
    <record id="coda_bon_commande" model="ir.actions.report">
        <field name="name">Coda Bon de Commande</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">coda_sale_order.report_coda_bon_commande_document</field>
        <field name="report_file">coda_sale_order.report_coda_bon_commande_document</field>
        <field name="print_report_name">'BC-%s' % (object.name)</field>
        <field name="paperformat_id" ref="coda_sale_order.paperformat_coda_devis"/>
    </record>

    <!-- =========================================================
         Template QWeb — BON DE COMMANDE
    ========================================================= -->
    <template id="report_coda_bon_commande_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="
                    font-family: Arial, 'Liberation Sans', sans-serif;
                    font-size: 11px;
                    color: #222222;
                    padding: 4mm 8mm 55mm 8mm;
                    position: relative;
                    min-height: 262mm;
                ">


                    <!-- ==============================================
                         EN-TÊTE : Logos (gauche) | Infos société (droite)
                    ============================================== -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                        <tr>
                            <!-- Logos empilés à gauche -->
                            <td style="width: 30%; vertical-align: top; padding-right: 10px;">
                                <img t-if="logo_coda" t-att-src="logo_coda"
                                     style="max-height: 80px; max-width: 155px; display: block; margin-bottom: 6px;"/>
                                <img t-if="logo_mase" t-att-src="logo_mase"
                                     style="max-height: 50px; max-width: 100px; display: block;"/>
                            </td>
                            <!-- Infos société à droite -->
                            <td style="width: 70%; vertical-align: top; text-align: right; font-size: 11px; line-height: 1.6; font-family: Arial, sans-serif;">
                                <strong style="font-size: 12px;">
                                    <span t-esc="o.company_id.name"/>
                                </strong><br/>
                                <t t-if="o.company_id.street">
                                    <span t-esc="o.company_id.street"/><br/>
                                </t>
                                <t t-if="o.company_id.zip or o.company_id.city">
                                    <span t-esc="(o.company_id.zip or '') + ' ' + (o.company_id.city or '')"/><br/>
                                </t>
                                <t t-if="o.company_id.company_registry">
                                    R.C. N° <span t-esc="o.company_id.company_registry"/> - CC : <span t-esc="o.company_id.vat"/><br/>
                                </t>
                                <t t-if="o.company_id.phone">
                                    TEL : <span t-esc="o.company_id.phone"/> / <span t-esc="o.company_id.mobile"/><br/>
                                </t>
                                <t t-if="o.company_id.email">
                                    E-mail : <span t-esc="o.company_id.email"/><br/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <hr style="border: none; border-top: 1.5px solid #bbbbbb; margin: 6px 0 10px 0;"/>

                    <!-- ==============================================
                         TITRE + CLIENT (côte à côte)
                    ============================================== -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                        <tr>
                            <!-- Gauche : Titre + table numéro/date -->
                            <td style="width: 55%; vertical-align: top; padding-right: 12px;">
                                <div style="font-size: 22px; font-weight: bold; font-family: Arial, sans-serif; letter-spacing: 1px; margin-bottom: 10px;">
                                    BON DE COMMANDE
                                </div>
                                <table style="border-collapse: collapse; width: auto;">
                                    <tr style="background-color: #ebebeb;">
                                        <th style="border: 1px solid #999999; padding: 5px 20px; text-align: center; font-size: 10px; font-family: Arial, sans-serif;">Numero</th>
                                        <th style="border: 1px solid #999999; padding: 5px 20px; text-align: center; font-size: 10px; font-family: Arial, sans-serif;">Date</th>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #999999; padding: 5px 20px; text-align: center; color: #1a5fad; font-weight: bold; font-family: Arial, sans-serif;">
                                            <span t-esc="o.name"/>
                                        </td>
                                        <td style="border: 1px solid #999999; padding: 5px 20px; text-align: center; font-family: Arial, sans-serif;">
                                            <span t-esc="o.date_order.strftime('%d/%m/%Y') if o.date_order else ''"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Droite : Nom client en grand -->
                            <td style="width: 45%; vertical-align: middle; text-align: center;
                                       border: 2px solid #999999; padding: 10px 16px;">
                                <strong style="font-size: 22px; font-family: Arial, sans-serif; letter-spacing: 1px;">
                                    <span t-esc="o.partner_id.name"/>
                                </strong>
                                <t t-if="o.partner_id.street">
                                    <br/><span style="font-size: 10px; color: #555555;"
                                          t-esc="(o.partner_id.street or '').upper()"/>
                                </t>
                                <t t-if="o.partner_id.vat">
                                    <br/><span style="font-size: 10px; color: #555555;">
                                        C.C : <span t-esc="o.partner_id.vat"/>
                                    </span>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- ==============================================
                         TABLEAU DES LIGNES
                    ============================================== -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                        <thead>
                            <tr style="background-color: #ebebeb;">
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: left;   font-size: 10px; width: 12%; font-family: Arial, sans-serif;">Reference</th>
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: left;   font-size: 10px;            font-family: Arial, sans-serif;">Designation</th>
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: center; font-size: 10px; width: 7%;  font-family: Arial, sans-serif;">Qte</th>
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: right;  font-size: 10px; width: 14%; font-family: Arial, sans-serif;">Px unitaire</th>
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: center; font-size: 10px; width: 9%;  font-family: Arial, sans-serif;">Remise (%)</th>
                                <th style="border: 1px solid #999999; padding: 6px 8px; text-align: right;  font-size: 10px; width: 14%; font-family: Arial, sans-serif;">Montant HT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line" t-as="line">

                                <!-- Section -->
                                <t t-if="line.display_type == 'line_section'">
                                    <tr>
                                        <td colspan="6" style="padding: 6px 8px; font-weight: bold; background-color: #f5f5f5; border-bottom: 1px solid #cccccc; font-family: Arial, sans-serif;">
                                            <span t-esc="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Note -->
                                <t t-elif="line.display_type == 'line_note'">
                                    <tr>
                                        <td colspan="6" style="padding: 4px 8px; font-style: italic; color: #555555; font-family: Arial, sans-serif;">
                                            <span t-esc="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Ligne produit -->
                                <t t-else="">
                                    <tr>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="line.product_id.default_code or ''"/>
                                        </td>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="line.product_id.name or line.name or ''"/>
                                        </td>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; text-align: center; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="int(line.product_uom_qty)"/>
                                        </td>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; text-align: right; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="'{:,.0f}'.format(line.price_unit).replace(',', ' ')"/>
                                        </td>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; text-align: center; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="'{:.0f}%'.format(line.discount) if line.discount else '-'"/>
                                        </td>
                                        <td style="border: 1px solid #cccccc; padding: 5px 8px; text-align: right; vertical-align: top; font-family: Arial, sans-serif;">
                                            <span t-esc="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>

                            </t>
                        </tbody>
                    </table>

                    <!-- ==============================================
                         PIED : Signature | Totaux  (position absolue → toujours en bas)
                    ============================================== -->
                    <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 0 8mm 10mm 8mm;">
                    <table style="width: 100%; border-collapse: collapse; margin-top: 0;">
                        <tr>
                            <!-- Bloc signature -->
                            <td style="width: 40%; vertical-align: top; padding-right: 10px;">
                                <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; border: 1px solid #999999;">
                                    <tr>
                                        <td style="padding: 5px 10px; background-color: #ebebeb; font-weight: bold; font-size: 10px;">
                                            SIGNATURE
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="height: 60px; padding: 8px; text-align: center; vertical-align: middle;">
                                            <img t-if="logo_coda" t-att-src="logo_coda"
                                                 style="max-height: 50px; max-width: 120px; opacity: 0.5;"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <!-- Totaux -->
                            <td style="width: 60%; vertical-align: top;">
                                <table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; border: 1px solid #999999;">
                                    <tr>
                                        <td style="padding: 5px 10px; background-color: #f5f5f5;">
                                            <strong>TOTAL HT</strong>
                                        </td>
                                        <td style="padding: 5px 10px; text-align: right;">
                                            <span t-esc="'{:,.0f}'.format(o.amount_untaxed).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px 10px; background-color: #f5f5f5;">
                                            <strong>T.V.A</strong>
                                        </td>
                                        <td style="padding: 5px 10px; text-align: right;">
                                            <span t-esc="'{:,.0f}'.format(o.amount_tax).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 10px; background-color: #dddddd;">
                                            <strong>NET A PAYER</strong>
                                        </td>
                                        <td style="padding: 6px 10px; text-align: right; background-color: #dddddd;">
                                            <strong>
                                                <span t-esc="'{:,.0f}'.format(o.amount_total).replace(',', ' ')"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>
