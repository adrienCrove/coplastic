<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_waste_purchase_wizard_form" model="ir.ui.view">
        <field name="name">report.waste.purchase.wizard.form</field>
        <field name="model">report.waste.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport Stock par Produit">
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Imprimer" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_waste_purchase_wizard" model="ir.actions.act_window">
        <field name="name">Rapport Stock par Produit</field>
        <field name="res_model">report.waste.purchase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_waste_purchase_report"
              name="Rapport Stock par Produit"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_open_waste_purchase_wizard"
              sequence="99"/>

</odoo>
