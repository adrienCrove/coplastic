<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_waste_purchase_wizard_form" model="ir.ui.view">
        <field name="name">report.waste.purchase.wizard.form</field>
        <field name="model">report.waste.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Grand Livre Achats">
                <group col="4">
                    <field name="mode" widget="radio"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimer" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_waste_purchase_wizard" model="ir.actions.act_window">
        <field name="name">Grand Livre Achats</field>
        <field name="res_model">report.waste.purchase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_waste_purchase_report"
              name="Grand Livre Achats"
              parent="stock.menu_warehouse_report"
              action="action_open_waste_purchase_wizard"
              sequence="99"/>

</odoo>
