<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajouter le seuil d'alerte stock sur la fiche produit -->
    <record id="view_product_form_stock_alert" model="ir.ui.view">
        <field name="name">product.template.form.stock.alert</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Alerte de stock" name="stock_alert_group" invisible="type == 'service' or not sale_ok">
                    <field name="stock_alert_qty" string="Seuil d'alerte stock"
                           help="Envoyer une alerte email quand le stock descend sous ce seuil (0 = désactivé)"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_last_print" model="ir.ui.view">
        <field name="name">stock.picking.form.last_print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Afficher le champ dernière impression -->
            <xpath expr="//field[@name='date_done']" position="after">
                <field name="last_print_date"/>
            </xpath>

            <!-- Total quantité en bas des lignes de produit (onglet Opérations) -->
            <xpath expr="//field[@name='move_ids_without_package']" position="after">
                <div class="row justify-content-end" style="margin-top: 8px;">
                    <div class="col-auto">
                        <table class="table table-sm table-borderless" style="width: auto;">
                            <tr style="font-size: 14px; font-weight: bold;">
                                <td class="text-end pe-3">Quantité totale :</td>
                                <td class="text-end" style="min-width: 80px; padding-right: 10px;">
                                    <field name="total_product_qty" nolabel="1"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </xpath>

            <!-- Remplacer le bouton Imprimer (état done) pour capturer la date -->
            <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="attributes">
                <attribute name="name">action_print_delivery_slip</attribute>
                <attribute name="type">object</attribute>
            </xpath>

            <!-- Onglet Historique d'impressions après Notes -->
            <xpath expr="//page[@name='note']" position="after">
                <page string="Historique d'impressions" name="print_history">
                    <field name="print_history_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="print_number" string="N°"/>
                            <field name="print_date" string="Date/Heure"/>
                            <field name="user_id" string="Utilisateur"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
