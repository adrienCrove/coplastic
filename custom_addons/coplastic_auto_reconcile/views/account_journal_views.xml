<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_auto_reconcile" model="ir.ui.view">
        <field name="name">account.journal.form.auto_reconcile</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_sequence']" position="after">
                <field name="auto_reconcile"
                       invisible="type not in ('bank', 'cash')"/>
            </xpath>
        </field>
    </record>

</odoo>
