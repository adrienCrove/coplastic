<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_reconciled_payments" model="ir.ui.view">
        <field name="name">account.move.form.reconciled.payments</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="reconciled_payment_count" invisible="1"/>
                <button name="action_open_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="reconciled_payment_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="reconciled_payment_count" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Paiement(s)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
