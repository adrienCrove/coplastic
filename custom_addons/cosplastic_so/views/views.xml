<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ajouter NCC et renommer TVA en N°RCCM sur la fiche partenaire -->
    <record id="view_partner_form_coplastic" model="ir.ui.view">
        <field name="name">res.partner.form.coplastic</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Cacher le label N° TVA ajouté par base_vat -->
            <xpath expr="//label[@for='vat']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Cacher le conteneur vat_vies -->
            <xpath expr="//div[@name='vat_vies_container']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Ajouter N°RCCM et NCC après le conteneur vat caché -->
            <xpath expr="//div[@name='vat_vies_container']" position="after">
                <field name="rccm" string="N°RCCM" placeholder="ex. CI-ABJ-2026-B-12345"/>
                <field name="ncc" string="NCC" placeholder="ex. 2012345 A"/>
            </xpath>
        </field>
    </record>

    <!-- Restreindre le bouton Déverrouiller à l'admin uniquement -->
    <record id="view_order_form_coplastic" model="ir.ui.view">
        <field name="name">sale.order.form.coplastic</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_unlock']" position="attributes">
                <attribute name="groups">base.group_system</attribute>
            </xpath>
        </field>
    </record>

</odoo>
