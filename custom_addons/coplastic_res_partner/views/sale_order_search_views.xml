<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_filter_this_month" model="ir.ui.view">
        <field name="name">sale.order.search.this.month</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Ce mois" name="filter_this_month"
                    domain="[('date_order', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_order', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mois dernier" name="filter_last_month"
                    domain="[('date_order', '&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')), ('date_order', '&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
            </filter>
        </field>
    </record>

    <record id="view_sale_report_filter_this_month" model="ir.ui.view">
        <field name="name">sale.report.search.this.month</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <filter name="filter_date" position="before">
                <filter string="Ce mois" name="filter_this_month"
                    domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mois dernier" name="filter_last_month"
                    domain="[('date', '&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')), ('date', '&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
            </filter>
        </field>
    </record>

</odoo>