<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="pos_config_view_form_fne" model="ir.ui.view">
        <field name="name">pos.config.form.fne</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fne_point_of_sale"
                       placeholder="Ex: SIEGE — vide = point de vente global FNE"/>
            </xpath>
        </field>
    </record>

</odoo>
