<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Hériter la vue formulaire de account.move pour ajouter les champs FNE -->
    <record id="view_move_form_fne" model="ir.ui.view">
        <field name="name">account.move.form.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Bouton de certification manuelle dans le header -->
            <xpath expr="//header" position="inside">
                <button name="action_fne_certify"
                        string="Certifier FNE"
                        type="object"
                        class="btn-warning"
                        invisible="fne_certified or state != 'posted' or move_type not in ('out_invoice', 'out_refund')"
                        groups="account.group_account_invoice"/>
            </xpath>

            <!-- Badge FNE dans le titre -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <field name="fne_certified" invisible="1"/>
                <div invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'">
                    <span class="badge rounded-pill text-bg-success fs-6"
                          invisible="not fne_certified">
                        FNE Certifiée
                    </span>
                    <span class="badge rounded-pill text-bg-danger fs-6"
                          invisible="fne_certified">
                        FNE Non certifiée
                    </span>
                </div>
            </xpath>

            <!-- Onglet FNE dans le notebook -->
            <xpath expr="//page[@name='other_info']" position="after">
                <page string="FNE / DGI"
                      name="fne_tab"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="Certification FNE">
                            <field name="fne_reference"/>
                            <field name="fne_ncc"/>
                            <field name="fne_certification_date"/>
                            <field name="fne_balance_sticker"/>
                        </group>
                        <group string="QR Code de vérification">
                            <field name="fne_qr_code" widget="image"
                                   class="oe_avatar"
                                   invisible="not fne_qr_code"/>
                            <field name="fne_token" widget="url"
                                   invisible="not fne_token"/>
                        </group>
                    </group>
                    <group invisible="not fne_error_message">
                        <field name="fne_error_message"
                               readonly="1"
                               class="text-danger"/>
                    </group>
                    <field name="fne_invoice_id" invisible="1"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Ajouter la colonne FNE dans la vue liste des factures -->
    <record id="view_move_tree_fne" model="ir.ui.view">
        <field name="name">account.move.tree.fne</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="fne_certified" string="FNE" widget="boolean_toggle" readonly="1"
                       optional="show"/>
                <field name="fne_reference" string="Réf. FNE" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
