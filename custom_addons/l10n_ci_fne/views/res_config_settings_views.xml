<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_fne" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fne</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Facture Normalisée Électronique (FNE)" name="fne_settings">
                    <setting string="Configuration FNE / DGI"
                             help="Paramètres de connexion à la plateforme FNE de la DGI Côte d'Ivoire">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ci_fne_api_url" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_api_url" class="col-5"
                                       placeholder="URL fournie par la DGI"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ci_fne_api_key" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_api_key" class="col-5" password="True"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Identification entreprise"
                             help="Informations d'identification de votre entreprise auprès de la DGI">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ci_fne_ncc" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_ncc" class="col-5"
                                       placeholder="Ex: 9606123E"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ci_fne_establishment" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_establishment" class="col-5"
                                       placeholder="Ex: Siège Coplastic"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ci_fne_point_of_sale" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_point_of_sale" class="col-5"
                                       placeholder="Ex: 1"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ci_fne_tax_regime" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_tax_regime" class="col-5"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ci_fne_tax_center" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_ci_fne_tax_center" class="col-5"
                                       placeholder="Ex: 822 Recette des Grandes Entreprises"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Mode simulation"
                             help="Prépare les requêtes sans les envoyer à la DGI. Les données sont loguées pour vérification.">
                        <field name="l10n_ci_fne_simulation"/>
                        <div class="text-warning mt8" style="font-size: 12px;">
                            Désactivez le mode simulation uniquement quand vous êtes prêt
                            à envoyer de vraies factures à la DGI.
                        </div>
                    </setting>
                    <setting string="Certification automatique"
                             help="Certifier automatiquement les factures validées. ATTENTION : chaque certification consomme un sticker FNE.">
                        <field name="l10n_ci_fne_auto_certify"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
