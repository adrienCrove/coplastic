<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Format papier dédié : le modèle DGI porte son propre en-tête, on ne
         réserve donc aucune marge pour un header/footer Odoo. -->
    <record id="paperformat_fne_invoice" model="report.paperformat">
        <field name="name">Facture Normalisée Électronique (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_invoice_fne" model="ir.actions.report">
        <field name="name">Facture normalisée (FNE)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ci_fne.report_invoice_fne_document</field>
        <field name="report_file">l10n_ci_fne.report_invoice_fne_document</field>
        <field name="paperformat_id" ref="l10n_ci_fne.paperformat_fne_invoice"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'FNE - %s' % (object.fne_reference or object.name)</field>
    </record>

    <!-- Corps du document normalisé, partagé par la facture (account.move)
         et le reçu de caisse (pos.order). Attend `o` (le document) et `d`
         (le retour de son _fne_get_report_data()). -->
    <template id="fne_document_body">
    <div class="fne-page">

        <style>
            .fne-page { font-family: Arial, Helvetica, sans-serif; font-size: 8.5pt; color: #000; line-height: 1.45; }
            .fne-page table { border-collapse: collapse; }
            .fne-idbox { border: 1px solid #000; padding: 7px 11px; display: inline-block; }
            .fne-meta div { margin-top: 1px; }
            .fne-doctitle { font-size: 10pt; text-align: center; margin-top: 6px; }
            .fne-fnecaption { color: #1e8f3e; font-weight: bold; font-size: 7.5pt; text-align: center; line-height: 1.2; margin-top: 2px; }
            .fne-client { margin-top: 10px; }
            .fne-lines { width: 100%; border: 1px solid #000; margin-top: 26px; }
            .fne-lines th { border: 1px solid #000; padding: 7px 6px; font-weight: bold; vertical-align: bottom; text-align: left; }
            .fne-lines th.fne-num, .fne-lines td.fne-num { text-align: right; }
            .fne-lines td { border: 1px solid #000; padding: 6px; vertical-align: top; }
            .fne-lines .fne-filler { border-right: 1px solid #000; }
            .fne-lines .fne-totlabel { border-top: 1px solid #000; border-left: 1px solid #000; font-weight: bold; padding: 6px; }
            .fne-lines .fne-totvalue { border-top: 1px solid #000; text-align: right; padding: 6px; }
            .fne-summary { width: 100%; border: 1px solid #000; margin-top: 6px; }
            .fne-summary th { border: 1px solid #000; padding: 6px; font-weight: bold; background-color: #f2f2f2; text-align: left; }
            .fne-summary th.fne-num, .fne-summary td.fne-num { text-align: right; }
            .fne-summary td { border: 1px solid #000; padding: 6px; }
            .fne-num { text-align: right; white-space: nowrap; }
        </style>

        <!-- ================= EN-TÊTE ================= -->
        <table style="width: 100%; table-layout: fixed;">
            <tr>
                <!-- Colonne gauche : identification de l'émetteur -->
                <td style="width: 52%; vertical-align: top; padding-right: 12px;">
                    <div class="fne-idbox">
                        <div style="font-weight: bold;" t-out="d['company_name']"/>
                        <div>NCC : <span t-out="d['company_ncc']"/></div>
                        <div>Régime d'imposition : <span t-out="d['company_tax_regime']"/></div>
                        <div>Centre des impôts : <span t-out="d['company_tax_center']"/></div>
                    </div>
                    <div class="fne-meta" style="margin-top: 9px;">
                        <div>RCCM : <span t-out="d['company_rccm']"/></div>
                        <div>Établissement : <span t-out="d['establishment']"/></div>
                        <div>Adresse : <span t-out="d['company_address']"/></div>
                        <div>N° Tel : <span t-out="d['company_phone']"/></div>
                        <div>Mail : <span t-out="d['company_email']"/></div>
                        <div>Nom de PDV : <span t-out="d['point_of_sale']"/></div>
                        <div>Date et heure : <span t-out="d['certification_date']"/></div>
                        <div>Mode de paiement : <span t-out="d['payment_method']"/></div>
                        <div>N° facture ERP : <span t-out="d['erp_number']"/></div>
                        <div>Date facture ERP : <span t-out="d['erp_date']"/></div>
                    </div>
                </td>

                <!-- Colonne droite : logo, référence FNE, QR code, client -->
                <td style="width: 48%; vertical-align: top;">
                    <div style="text-align: right; min-height: 30px;">
                        <img t-if="o.company_id.logo"
                             t-att-src="image_data_uri(o.company_id.logo)"
                             style="max-height: 42px; max-width: 175px;"
                             alt="Logo"/>
                    </div>
                    <div class="fne-doctitle">
                        <span t-out="d['document_title']"/> N°
                        <span t-out="d['fne_reference']"/>
                    </div>

                    <table style="width: 100%; margin-top: 10px;">
                        <tr>
                            <td style="width: 55%; vertical-align: middle;">
                                <img t-if="o.fne_qr_code"
                                     t-att-src="image_data_uri(o.fne_qr_code)"
                                     style="width: 105px; height: 105px;"
                                     alt="QR Code FNE"/>
                            </td>
                            <td style="width: 45%; vertical-align: middle; text-align: center;">
                                <img src="/l10n_ci_fne/static/img/fne_logo.png"
                                     style="width: 118px;"
                                     alt="Facture Normalisée Électronique"/>
                            </td>
                        </tr>
                    </table>

                    <div class="fne-client">
                        <div style="font-weight: bold;">Client</div>
                        <div>Nom : <span t-out="d['client_name']"/></div>
                        <div>Adresse : <span t-out="d['client_address']"/></div>
                        <div>NCC : <span t-out="d['client_ncc']"/></div>
                        <div>Régime d'imposition : <span t-out="d['client_tax_regime']"/></div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- ================= LIGNES + TOTAUX ================= -->
        <table class="fne-lines">
            <thead>
                <tr>
                    <th style="width: 14%;">Réf</th>
                    <th style="width: 27%;">Désignation</th>
                    <th style="width: 10%;" class="fne-num">P.U HT</th>
                    <th style="width: 7%;" class="fne-num">Qté</th>
                    <th style="width: 8%;">Unité</th>
                    <th style="width: 12%;">Taxes (%)</th>
                    <th style="width: 9%;" class="fne-num">Rem. (%)</th>
                    <th style="width: 13%;" class="fne-num">Montant HT</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="d['items']" t-as="item">
                    <td t-out="item['reference']"/>
                    <td style="white-space: pre-line;" t-out="item['description']"/>
                    <td class="fne-num" t-out="o._fne_format_amount(item['price_unit'])"/>
                    <td class="fne-num" t-out="o._fne_format_quantity(item['quantity'])"/>
                    <td t-out="item['uom']"/>
                    <td t-out="item['taxes']"/>
                    <td class="fne-num" t-out="o._fne_format_rate(item['discount'])"/>
                    <td class="fne-num" t-out="o._fne_format_amount(item['subtotal'])"/>
                </tr>

                <!-- Bloc totaux : occupe la partie droite du tableau,
                     la zone Réf/Désignation restant vide comme sur le modèle DGI. -->
                <tr t-foreach="d['totals']" t-as="tot">
                    <td t-if="tot_first"
                        class="fne-filler"
                        colspan="2"
                        t-att-rowspan="d['totals_count']"
                        style="border-bottom: none; border-left: none;"/>
                    <td class="fne-totlabel" colspan="5">
                        <span t-att-style="tot['strong'] and 'font-weight: bold;' or ''"
                              t-out="tot['label']"/>
                    </td>
                    <td class="fne-totvalue">
                        <span t-att-style="tot['strong'] and 'font-weight: bold;' or ''"
                              t-out="o._fne_format_amount(tot['value'])"/>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- ================= RÉSUMÉ ================= -->
        <div style="font-weight: bold; margin-top: 18px;">RESUME DE LA FACTURE</div>
        <table class="fne-summary">
            <thead>
                <tr>
                    <th style="width: 46%;">CATEGORIE</th>
                    <th style="width: 20%;" class="fne-num">SOUS-TOTAL</th>
                    <th style="width: 14%;" class="fne-num">TAUX (%)</th>
                    <th style="width: 20%;" class="fne-num">TOTAL TAXES</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="d['tax_summary']" t-as="tax">
                    <td t-out="tax['category']"/>
                    <td class="fne-num" t-out="o._fne_format_amount(tax['base'])"/>
                    <td class="fne-num"><span t-out="o._fne_format_rate(tax['rate'])"/>%</td>
                    <td class="fne-num" t-out="o._fne_format_amount(tax['amount'])"/>
                </tr>
            </tbody>
        </table>

    </div>
    </template>

    <!-- Reproduction du modèle de facture normalisée de la plateforme DGI.
         Volontairement autonome : pas de t-call vers web.external_layout, afin
         que les surcharges de layout (coplastic_report) n'altèrent pas un
         document fiscal dont la mise en page est imposée. -->
    <template id="report_invoice_fne_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="d" t-value="o._fne_get_report_data()"/>
                <div class="article"
                     t-att-data-oe-model="o._name"
                     t-att-data-oe-id="o.id"
                     t-att-data-oe-lang="o.env.context.get('lang')">
                    <t t-call="l10n_ci_fne.fne_document_body"/>
                </div>
                <div t-if="not o_last" style="page-break-after: always;"/>
            </t>
        </t>
    </template>

</odoo>
