<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Valeurs par défaut pour la configuration FNE -->
        <record id="default_fne_auto_certify" model="ir.config_parameter">
            <field name="key">l10n_ci_fne.auto_certify</field>
            <field name="value">False</field>
        </record>

        <record id="default_fne_simulation" model="ir.config_parameter">
            <field name="key">l10n_ci_fne.simulation</field>
            <field name="value">True</field>
        </record>

        <record id="default_fne_point_of_sale" model="ir.config_parameter">
            <field name="key">l10n_ci_fne.point_of_sale</field>
            <field name="value">1</field>
        </record>

    </data>
</odoo>
