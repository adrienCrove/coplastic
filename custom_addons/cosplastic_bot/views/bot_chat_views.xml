<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chat Form View -->
    <record id="view_bot_chat_form" model="ir.ui.view">
        <field name="name">cosplastic.bot.chat.form</field>
        <field name="model">cosplastic.bot.chat</field>
        <field name="arch" type="xml">
            <form string="Conversation IA">
                <header>
                    <button name="action_close" type="object" string="Fermer"
                            class="btn-secondary" invisible="state == 'closed'"/>
                    <button name="action_reopen" type="object" string="Réouvrir"
                            class="btn-secondary" invisible="state == 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="config_id" required="1"/>
                        </group>
                        <group>
                            <field name="title" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Zone de conversation -->
                    <group string="Conversation">
                        <field name="message_ids" nolabel="1" readonly="1">
                            <tree create="0" delete="0" decoration-info="role=='assistant'" decoration-muted="role=='system'">
                                <field name="create_date" string="Date"/>
                                <field name="role"/>
                                <field name="content"/>
                                <field name="tokens_used"/>
                            </tree>
                        </field>
                    </group>

                    <!-- Zone de saisie -->
                    <group string="Nouveau message" invisible="state == 'closed'">
                        <field name="new_message" nolabel="1"
                               placeholder="Tapez votre message ici..."
                               widget="text"/>
                        <button name="send_message" type="object"
                                string="Envoyer" class="btn-primary oe_highlight"
                                icon="fa-paper-plane"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Chat Tree View -->
    <record id="view_bot_chat_tree" model="ir.ui.view">
        <field name="name">cosplastic.bot.chat.tree</field>
        <field name="model">cosplastic.bot.chat</field>
        <field name="arch" type="xml">
            <tree string="Conversations">
                <field name="title"/>
                <field name="user_id"/>
                <field name="config_id"/>
                <field name="create_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Chat Kanban View -->
    <record id="view_bot_chat_kanban" model="ir.ui.view">
        <field name="name">cosplastic.bot.chat.kanban</field>
        <field name="model">cosplastic.bot.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="title"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="title"/></strong>
                                <div class="text-muted">
                                    <field name="user_id"/> - <field name="create_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Chat Search View -->
    <record id="view_bot_chat_search" model="ir.ui.view">
        <field name="name">cosplastic.bot.chat.search</field>
        <field name="model">cosplastic.bot.chat</field>
        <field name="arch" type="xml">
            <search string="Rechercher une conversation">
                <field name="title"/>
                <field name="user_id"/>
                <filter string="Mes conversations" name="my_chats"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Actives" name="active_chats"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Fermées" name="closed_chats"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Utilisateur" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="État" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Chat Action -->
    <record id="action_bot_chat" model="ir.actions.act_window">
        <field name="name">Conversations IA</field>
        <field name="res_model">cosplastic.bot.chat</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_my_chats': 1, 'search_default_active_chats': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Démarrez une nouvelle conversation avec l'assistant IA
            </p>
            <p>
                Posez vos questions et effectuez des actions Odoo en langage naturel.
            </p>
        </field>
    </record>
</odoo>
