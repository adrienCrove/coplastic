<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration Form View -->
    <record id="view_bot_config_form" model="ir.ui.view">
        <field name="name">cosplastic.bot.config.form</field>
        <field name="model">cosplastic.bot.config</field>
        <field name="arch" type="xml">
            <form string="Configuration ChatGPT pour OdooBot">
                <header>
                    <button name="test_connection" type="object"
                            string="🔗 Tester la connexion" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-power-off">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la configuration"/>
                        </h1>
                    </div>
                    <group>
                        <group string="🔑 Connexion API OpenAI">
                            <field name="api_key" password="True"
                                   placeholder="sk-..."/>
                            <field name="model"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="⚙️ Paramètres">
                            <field name="max_tokens"
                                   help="Nombre maximum de tokens dans la réponse"/>
                            <field name="temperature" widget="float"
                                   help="0 = déterministe, 1 = créatif"/>
                        </group>
                    </group>
                    <group string="📝 Prompt Système">
                        <field name="system_prompt" nolabel="1"
                               placeholder="Instructions pour l'assistant IA..."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>💡 Comment utiliser :</strong>
                        <ol>
                            <li>Entrez votre clé API OpenAI</li>
                            <li>Testez la connexion avec le bouton ci-dessus</li>
                            <li>Parlez à OdooBot dans Discuss - il utilisera ChatGPT pour répondre !</li>
                        </ol>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Configuration Tree View -->
    <record id="view_bot_config_tree" model="ir.ui.view">
        <field name="name">cosplastic.bot.config.tree</field>
        <field name="model">cosplastic.bot.config</field>
        <field name="arch" type="xml">
            <tree string="Configurations ChatGPT">
                <field name="name"/>
                <field name="model"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Configuration Action -->
    <record id="action_bot_config" model="ir.actions.act_window">
        <field name="name">Configuration ChatGPT</field>
        <field name="res_model">cosplastic.bot.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurez ChatGPT pour améliorer OdooBot
            </p>
            <p>
                Une fois configuré, OdooBot utilisera l'IA pour répondre
                à vos questions dans Discuss.
            </p>
        </field>
    </record>
</odoo>
