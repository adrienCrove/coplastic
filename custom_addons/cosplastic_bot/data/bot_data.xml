<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Partner pour CoplasticBot -->
        <record id="partner_coplastic_bot" model="res.partner">
            <field name="name">CoplasticBot</field>
            <field name="email">coplasticbot@coplastic.adriennde.com</field>
            <field name="active">True</field>
            <field name="is_company">False</field>
            <field name="type">contact</field>
        </record>

        <!-- Configuration par défaut -->
        <record id="default_bot_config" model="cosplastic.bot.config">
            <field name="name">Configuration ChatGPT par défaut</field>
            <field name="api_key">YOUR_API_KEY_HERE</field>
            <field name="model">gpt-4o-mini</field>
            <field name="max_tokens">2000</field>
            <field name="temperature">0.7</field>
            <field name="system_prompt">Tu es CoplasticBot, un assistant IA pour Odoo ERP de l'entreprise Coplastic.
Tu aides les utilisateurs à :
- Créer des devis et commandes
- Consulter les stocks
- Gérer les clients et fournisseurs
- Créer des factures
- Analyser les données

Réponds toujours en français, de manière concise et professionnelle.
Si tu ne peux pas effectuer une action, explique pourquoi et propose une alternative.</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
