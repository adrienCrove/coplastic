<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permet aux Gestionnaires des ventes de voir Ventes > Configuration > Paramètres
         sans avoir besoin de base.group_system (qui donne aussi accès aux Apps) -->
    <record id="sale.menu_sale_general_settings" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('base.group_system')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <!-- Restreint le menu Apps à base.group_system uniquement.
         Par défaut dans Odoo ce menu n'a aucune restriction (visible par tous). -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
