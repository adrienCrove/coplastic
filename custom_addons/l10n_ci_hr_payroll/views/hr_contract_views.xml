<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_contract_form_ci" model="ir.ui.view">
        <field name="name">hr.contract.form.ci</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <!-- Ajouter les champs CI dans le groupe yearly_benefits (à côté du salaire) -->
            <xpath expr="//group[@name='yearly_benefits']" position="inside">
                <field name="l10n_ci_sursalaire" widget="monetary"/>
                <field name="l10n_ci_prime_transport" widget="monetary"/>
                <field name="l10n_ci_indemnite_conge" widget="monetary"/>
                <field name="l10n_ci_taux_anciennete"/>
                <field name="l10n_ci_horaire_mensuel"/>
            </xpath>

        </field>
    </record>

</odoo>
