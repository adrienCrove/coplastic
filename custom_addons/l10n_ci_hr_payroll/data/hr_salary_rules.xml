    <!-- ============================================================ -->
    <!-- 4. AVANTAGES NON IMPOSABLES                                   -->
    <!-- ============================================================ -->

    <!-- 5020 - Prime de transport Abidjan -->
    <record id="rule_ci_transport" model="hr.salary.rule">
        <field name="name">Prime Transport Abidjan</field>
        <field name="code">CI_TRANSP</field>
        <field name="sequence" eval="40"/>
        <field name="category_id" ref="ci_categ_avantages"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_ci_prime_transport &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Transport proratisé comme le salaire (convention CI 30 jours)
jours = result_rules.CI_JOURS.total
result = contract.l10n_ci_prime_transport * jours / 30
result_qty = 1.0
        </field>
        <field name="note">Prime de transport non imposable proratisée (convention CI 30 jours).</field>
    </record>

    <!-- ============================================================ -->
    <!-- 5. NET A PAYER                                                -->
    <!-- ============================================================ -->

    <record id="rule_ci_net" model="hr.salary.rule">
        <field name="name">NET A PAYER</field>
        <field name="code">CI_NET</field>
        <field name="sequence" eval="99"/>
        <field name="category_id" ref="ci_categ_net"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Net = Brut + Cotisations salariales (négatives) + Avantages non imposables
brut = categories.CI_BRUT
cotis = categories.CI_COT_SAL  # Déjà négatif
avantages = categories.CI_AVT
net = brut + cotis + avantages
# Arrondi aux 500 FCFA inférieurs (pratique courante CI)
result = int(net / 500) * 500
result_qty = 1.0
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Net à payer = Brut - Cotisations salariales + Avantages, arrondi aux 500 FCFA.</field>
    </record>

</odoo>
