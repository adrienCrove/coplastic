<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="0">

    <!-- ============================================================ -->
    <!-- 0. JOURS TRAVAILLÉS (convention CI : 30 jours/mois)          -->
    <!--    Utilise le planning horaire employé pour détecter          -->
    <!--    automatiquement les absences                               -->
    <!-- ============================================================ -->

    <record id="rule_ci_jours" model="hr.salary.rule">
        <field name="name">Jours travaillés</field>
        <field name="code">CI_JOURS</field>
        <field name="sequence" eval="0"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if inputs.CI_JOURS_TRAV and inputs.CI_JOURS_TRAV.amount > 0:
    result = inputs.CI_JOURS_TRAV.amount
else:
    total_ouvrables = sum(line.number_of_days for line in payslip.worked_days_line_ids)
    jours_work = worked_days.WORK100.number_of_days if worked_days.WORK100 else total_ouvrables
    absences = max(0, total_ouvrables - jours_work)
    result = max(0, 30 - absences)
result_qty = 1.0
        </field>
        <field name="appears_on_payslip" eval="False"/>
        <field name="note">Jours payés (convention 30j/mois). Auto-calculé via le planning 40h/sem ou saisie manuelle CI_JOURS_TRAV.</field>
    </record>

    <!-- Input pour override manuel des jours travaillés -->
    <record id="rule_input_jours_trav" model="hr.rule.input">
        <field name="name">Jours travaillés (sur 30) - override</field>
        <field name="code">CI_JOURS_TRAV</field>
        <field name="input_id" ref="rule_ci_jours"/>
    </record>

    <!-- ============================================================ -->
    <!-- 1. GAINS - Éléments du salaire brut                          -->
    <!-- ============================================================ -->

    <!-- 1010 - Salaire de base catégoriel -->
    <record id="rule_ci_base" model="hr.salary.rule">
        <field name="name">Salaire de base catégoriel</field>
        <field name="code">CI_BASE</field>
        <field name="sequence" eval="1"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Convention CI : salaire proratisé sur 30 jours
# Utilise les jours calculés depuis le planning horaire
jours = result_rules.CI_JOURS.total
result = contract.wage * jours / 30
result_qty = 1.0
        </field>
        <field name="note">Salaire de base catégoriel proratisé : wage × jours / 30 (basé sur planning horaire).</field>
    </record>

    <!-- 1060 - Sursalaire -->
    <record id="rule_ci_sursalaire" model="hr.salary.rule">
        <field name="name">Sursalaire</field>
        <field name="code">CI_SURS</field>
        <field name="sequence" eval="2"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_ci_sursalaire &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
jours = result_rules.CI_JOURS.total
result = contract.l10n_ci_sursalaire * jours / 30
result_qty = 1.0
        </field>
        <field name="note">Complément salarial proratisé sur les jours travaillés.</field>
    </record>

    <!-- 1320 - Prime d'ancienneté -->
    <record id="rule_ci_anciennete" model="hr.salary.rule">
        <field name="name">Prime d'ancienneté</field>
        <field name="code">CI_ANC</field>
        <field name="sequence" eval="3"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_ci_taux_anciennete &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Prime d'ancienneté = taux% × salaire de base (déjà proratisé)
base = result_rules.CI_BASE.total
result = base * contract.l10n_ci_taux_anciennete / 100
result_qty = 1.0
        </field>
        <field name="note">Convention CI : 2% par an après 2 ans d'ancienneté, plafonné à 25%.</field>
    </record>

    <!-- 2090 - Allocation congé payés -->
    <record id="rule_ci_conge" model="hr.salary.rule">
        <field name="name">Allocation congé payés</field>
        <field name="code">CI_CONG</field>
        <field name="sequence" eval="4"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = contract.l10n_ci_indemnite_conge and contract.l10n_ci_indemnite_conge &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Jours de congé = 30 - jours travaillés
jours_trav = result_rules.CI_JOURS.total
jours_conge = max(0, 30 - jours_trav)
# Override par input spécifique si renseigné
if inputs.CI_JOURS_CONGE and inputs.CI_JOURS_CONGE.amount &gt; 0:
    jours_conge = inputs.CI_JOURS_CONGE.amount
result = contract.l10n_ci_indemnite_conge * jours_conge if jours_conge &gt; 0 else 0
result_qty = 1.0
        </field>
        <field name="note">Indemnité de congé payé = indemnité journalière × jours de congé.</field>
    </record>

    <!-- Input pour jours de congé manuels -->
    <record id="rule_input_jours_conge" model="hr.rule.input">
        <field name="name">Jours de congé payés</field>
        <field name="code">CI_JOURS_CONGE</field>
        <field name="input_id" ref="rule_ci_conge"/>
    </record>

    <!-- TOTAL BRUT -->
    <record id="rule_ci_brut" model="hr.salary.rule">
        <field name="name">Total Brut</field>
        <field name="code">CI_BRUT_TOTAL</field>
        <field name="sequence" eval="10"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.CI_BRUT
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Somme de tous les éléments du salaire brut.</field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. COTISATIONS SALARIALES                                     -->
    <!-- ============================================================ -->

    <!-- 5200 - Retraite CNPS (salarié) - 6.30% -->
    <record id="rule_ci_retraite_sal" model="hr.salary.rule">
        <field name="name">Régime de Retraite (salarié)</field>
        <field name="code">CI_RET_SAL</field>
        <field name="sequence" eval="20"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Retraite CNPS salarié : 6.30% du brut
# Plafond CNPS retraite : 45 × SMIG = 45 × 75 000 = 3 375 000 FCFA/mois
brut = categories.CI_BRUT
base = min(brut, 3375000)
result = -base * 6.30 / 100
result_qty = 1.0
        </field>
        <field name="register_id" ref="contrib_register_cnps"/>
        <field name="note">Cotisation retraite CNPS part salarié : 6.30% du brut (plafond 3 375 000 FCFA).</field>
    </record>

    <!-- 5000 - ITS mensuel -->
    <record id="rule_ci_its" model="hr.salary.rule">
        <field name="name">ITS mensuel</field>
        <field name="code">CI_ITS</field>
        <field name="sequence" eval="21"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Calcul ITS via la méthode du modèle hr.payslip
brut = categories.CI_BRUT
parts = employee.l10n_ci_parts_igr or 1.0
# Brut imposable annuel (brut mensuel × 12)
brut_annuel = brut * 12
its_mensuel = payslip._l10n_ci_compute_its(brut_annuel, parts)
result = -its_mensuel
result_qty = 1.0
        </field>
        <field name="register_id" ref="contrib_register_its"/>
        <field name="note">Impôt sur Traitements et Salaires - barème progressif CI avec quotient familial.</field>
    </record>

