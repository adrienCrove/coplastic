    <record id="rule_ci_transport_imp" model="hr.salary.rule">
        <field name="name">Prime Transport (imposable)</field>
        <field name="code">CI_TRANSP_IMP</field>
        <field name="sequence" eval="4"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_ci_prime_transport &gt; 30000</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Fraction imposable = montant total - plafond exonéré (30 000), proratisé
jours = result_rules.CI_JOURS.total
result = contract.l10n_ci_prime_transport - 30000
result_rate = jours / 30 * 100
result_qty = 1.0
