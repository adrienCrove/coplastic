        <field name="condition_python">result = inputs.CI_HS_50 and inputs.CI_HS_50.amount_qty > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
salaire_reel = contract.wage + (contract.l10n_ci_sursalaire or 0.0)
taux_horaire = salaire_reel / (contract.l10n_ci_horaire_mensuel or 173.33)
nb_heures = inputs.CI_HS_50.amount_qty
result = nb_heures * taux_horaire * 1.50
result_qty = nb_heures
        </field>
        <field name="account_debit" ref="account.1_pcg_6612"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="note">Heures supplémentaires majorées à 50% (47e à 55e heure en semaine).</field>
    </record>
    <record id="rule_input_hs_50" model="hr.rule.input">
        <field name="name">H. Sup. +50% — nombre d'heures</field>
        <field name="code">CI_HS_50</field>
        <field name="input_id" ref="rule_ci_hs_50"/>
    </record>

    <!-- HS +75% : heures de nuit (21h–5h) -->
    <record id="rule_ci_hs_75n" model="hr.salary.rule">
        <field name="name">H. Sup. +75% (nuit 21h–5h)</field>
        <field name="code">CI_HS_75N</field>
        <field name="sequence" eval="7"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = inputs.CI_HS_75N and inputs.CI_HS_75N.amount_qty > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
salaire_reel = contract.wage + (contract.l10n_ci_sursalaire or 0.0)
taux_horaire = salaire_reel / (contract.l10n_ci_horaire_mensuel or 173.33)
nb_heures = inputs.CI_HS_75N.amount_qty
result = nb_heures * taux_horaire * 1.75
result_qty = nb_heures
        </field>
        <field name="account_debit" ref="account.1_pcg_6612"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="note">Heures de nuit (21h–5h) majorées à 75%.</field>
    </record>
    <record id="rule_input_hs_75n" model="hr.rule.input">
        <field name="name">H. Sup. +75% nuit — nombre d'heures</field>
        <field name="code">CI_HS_75N</field>
        <field name="input_id" ref="rule_ci_hs_75n"/>
    </record>

    <!-- HS +75% : dimanches et jours fériés (jour) -->
    <record id="rule_ci_hs_75j" model="hr.salary.rule">
        <field name="name">H. Sup. +75% (dim./fériés jour)</field>
        <field name="code">CI_HS_75J</field>
        <field name="sequence" eval="8"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = inputs.CI_HS_75J and inputs.CI_HS_75J.amount_qty > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
salaire_reel = contract.wage + (contract.l10n_ci_sursalaire or 0.0)
taux_horaire = salaire_reel / (contract.l10n_ci_horaire_mensuel or 173.33)
nb_heures = inputs.CI_HS_75J.amount_qty
result = nb_heures * taux_horaire * 1.75
result_qty = nb_heures
        </field>
        <field name="account_debit" ref="account.1_pcg_6612"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="note">Heures dimanche/jours fériés (jour) majorées à 75%.</field>
    </record>
    <record id="rule_input_hs_75j" model="hr.rule.input">
        <field name="name">H. Sup. +75% dim./fériés jour — nombre d'heures</field>
        <field name="code">CI_HS_75J</field>
        <field name="input_id" ref="rule_ci_hs_75j"/>
    </record>

    <!-- HS +100% : dimanches et jours fériés (nuit 21h–5h) -->
    <record id="rule_ci_hs_100" model="hr.salary.rule">
        <field name="name">H. Sup. +100% (dim./fériés nuit)</field>
        <field name="code">CI_HS_100</field>
        <field name="sequence" eval="9"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = inputs.CI_HS_100 and inputs.CI_HS_100.amount_qty > 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
salaire_reel = contract.wage + (contract.l10n_ci_sursalaire or 0.0)
taux_horaire = salaire_reel / (contract.l10n_ci_horaire_mensuel or 173.33)
nb_heures = inputs.CI_HS_100.amount_qty
result = nb_heures * taux_horaire * 2.0
result_qty = nb_heures
        </field>
        <field name="account_debit" ref="account.1_pcg_6612"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="note">Heures dimanche/jours fériés (nuit 21h–5h) majorées à 100%.</field>
    </record>
    <record id="rule_input_hs_100" model="hr.rule.input">
        <field name="name">H. Sup. +100% dim./fériés nuit — nombre d'heures</field>
        <field name="code">CI_HS_100</field>
        <field name="input_id" ref="rule_ci_hs_100"/>
    </record>

    <!-- 2090 - Allocation congé payés -->
    <record id="rule_ci_conge" model="hr.salary.rule">
        <field name="name">Allocation congé payés</field>
        <field name="code">CI_CONG</field>
        <field name="sequence" eval="4"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
result = contract.l10n_ci_indemnite_conge and contract.l10n_ci_indemnite_conge &gt; 0
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Jours de congé = 30 - jours travaillés
jours_trav = result_rules.CI_JOURS.total
jours_conge = max(0, 30 - jours_trav)
# Override par input spécifique si renseigné
if inputs.CI_JOURS_CONGE and inputs.CI_JOURS_CONGE.amount_qty &gt; 0:
    jours_conge = inputs.CI_JOURS_CONGE.amount_qty
result = contract.l10n_ci_indemnite_conge * jours_conge if jours_conge &gt; 0 else 0
result_qty = 1.0
        </field>
        <field name="account_debit" ref="account.1_pcg_6613"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="note">Indemnité de congé payé = indemnité journalière × jours de congé.</field>
    </record>

    <!-- Input pour jours de congé manuels -->
    <record id="rule_input_jours_conge" model="hr.rule.input">
        <field name="name">Jours de congé payés</field>
        <field name="code">CI_JOURS_CONGE</field>
        <field name="input_id" ref="rule_ci_conge"/>
    </record>

    <!-- TOTAL BRUT — pas d'écriture comptable (ligne récapitulative) -->
    <record id="rule_ci_brut" model="hr.salary.rule">
        <field name="name">Total Brut</field>
        <field name="code">CI_BRUT_TOTAL</field>
        <field name="sequence" eval="10"/>
        <field name="category_id" ref="ci_categ_brut"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.CI_BRUT
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Somme de tous les éléments du salaire brut.</field>
    </record>

    <!-- IS Patronal - Impôt sur les Salaires - 1.20% -->
    <record id="rule_ci_is_pat" model="hr.salary.rule">
        <field name="name">Impôt sur les Salaires (patronal)</field>
        <field name="code">CI_IS_PAT</field>
        <field name="sequence" eval="11"/>
        <field name="category_id" ref="ci_categ_cotis_pat"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
brut = result_rules.CI_BRUT_TOTAL.total
result = brut
result_rate = 1.20
result_qty = 1.0
        </field>
        <field name="register_id" ref="contrib_register_its"/>
        <field name="account_debit" ref="account.1_pcg_6413"/>
        <field name="account_credit" ref="account.1_pcg_4472"/>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Impôt sur les Salaires (IS) : 1.20% du brut, charge patronale versée à la DGI.</field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. COTISATIONS SALARIALES                                     -->
    <!--    D : 422000 Personnel, rémunération due (retenue sur net)  -->
    <!--    C : 431xxx / 447xxx comptes tiers collecteurs             -->
    <!-- ============================================================ -->

    <!-- 5200 - Retraite CNPS (salarié) - 6.30% -->
    <record id="rule_ci_retraite_sal" model="hr.salary.rule">
        <field name="name">Régime de Retraite (salarié)</field>
        <field name="code">CI_RET_SAL</field>
        <field name="sequence" eval="20"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Retraite CNPS salarié : 6.30% du brut, plafond 45 × SMIG
smig = contract.company_id.l10n_ci_smig or 75000.0
brut = result_rules.CI_BRUT_TOTAL.total
base = min(brut, 45 * smig)
result = -base
result_rate = 6.30
result_qty = 1.0
        </field>
        <field name="register_id" ref="contrib_register_cnps"/>
        <field name="account_debit" ref="account.1_pcg_422"/>
        <field name="account_credit" ref="account.1_pcg_4313"/>
        <field name="note">Cotisation retraite CNPS part salarié : 6.30% du brut, plafond 45 × SMIG.</field>
    </record>

    <!-- ITS brut salarié — catégorie CI_TECH (hors total cotis. salariales) -->
    <record id="rule_ci_its" model="hr.salary.rule">
        <field name="name">ITS brut salarié</field>
        <field name="code">CI_ITS</field>
        <field name="sequence" eval="21"/>
        <field name="category_id" ref="ci_categ_tech"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# ITS barème 2024 : base = brut mensuel (plus d'abattement ni déduction CNPS)
brut = result_rules.CI_BRUT_TOTAL.total
its_brut = payslip._l10n_ci_compute_its(brut)
result = -its_brut
result_qty = 1.0
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">ITS brut mensuel barème 2024. Base = brut total, sans abattement.</field>
    </record>

    <!-- 5650 - CMU salarié : 500 FCFA × (1 + nb_enfants, max 5) -->
    <record id="rule_ci_cmu_sal" model="hr.salary.rule">
        <field name="name">Prélèvement CMU (salarié)</field>
        <field name="code">CI_CMU_SAL</field>
        <field name="sequence" eval="22"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
nb_enfants = min(int(employee.l10n_ci_nb_children or 0), 5)
result = -500
result_qty = 1 + nb_enfants
        </field>
        <field name="register_id" ref="contrib_register_cmu"/>
        <field name="account_debit" ref="account.1_pcg_422"/>
        <field name="account_credit" ref="account.1_pcg_4318"/>
        <field name="note">CMU salarié : 500 FCFA × (1 + nb enfants à charge, plafonné à 5).</field>
    </record>

    <!-- IPS salarié - montant fixe mensuel configuré sur le contrat -->
    <record id="rule_ci_ips_sal" model="hr.salary.rule">
        <field name="name">Cotisation IPS (salarié)</field>
        <field name="code">CI_IPS_SAL</field>
        <field name="sequence" eval="23"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.l10n_ci_montant_ips &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = -contract.l10n_ci_montant_ips
result_qty = 1.0
        </field>
        <field name="account_debit" ref="account.1_pcg_422"/>
        <field name="account_credit" ref="account.1_pcg_4313"/>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Cotisation IPS brut salariale : taux à configurer sur le contrat.</field>
    </record>

    <!-- Réduction d'impôt mensuelle - montant à déterminer sur contrat -->
    <record id="rule_ci_red_imp" model="hr.salary.rule">
        <field name="name">Réduction d'impôt</field>
        <field name="code">CI_RED_IMP</field>
        <field name="sequence" eval="24"/>
        <field name="category_id" ref="ci_categ_tech"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = (employee.l10n_ci_parts_igr or 1.0) &gt; 1.0 or contract.l10n_ci_reduction_impot &gt; 0</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Si montant manuel saisi sur le contrat → l'utiliser, sinon RICF automatique
if contract.l10n_ci_reduction_impot &gt; 0:
    result = contract.l10n_ci_reduction_impot
else:
    parts = employee.l10n_ci_parts_igr or 1.0
    result = payslip._l10n_ci_compute_ricf(parts)
result_qty = 1.0
        </field>
        <field name="account_debit" ref="account.1_pcg_4471"/>
        <field name="account_credit" ref="account.1_pcg_422"/>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">RICF 2024 : réduction automatique basée sur les parts IGR de l'employé.</field>
    </record>

    <!-- ITS Net salarial = ITS - Réduction d'impôt -->
    <record id="rule_ci_its_net" model="hr.salary.rule">
        <field name="name">ITS Net salarial</field>
        <field name="code">CI_ITS_NET</field>
        <field name="sequence" eval="25"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
its_obj = result_rules.CI_ITS
its = its_obj.total if its_obj else 0.0
red_obj = result_rules.CI_RED_IMP
red = red_obj.total if red_obj else 0.0
# ITS net ne peut pas être positif (pas de remboursement)
result = min(its + red, 0)
result_qty = 1.0
        </field>
        <field name="account_debit" ref="account.1_pcg_422"/>
        <field name="account_credit" ref="account.1_pcg_4471"/>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">ITS net = ITS mensuel - réduction d'impôt. Remplace CI_ITS dans le total.</field>
    </record>

    <!-- TOTAL COTISATIONS SALARIALES — pas d'écriture comptable -->
    <record id="rule_ci_total_cotis_sal" model="hr.salary.rule">
        <field name="name">Total Cotisations salariales</field>
        <field name="code">CI_TOT_COT_SAL</field>
        <field name="sequence" eval="29"/>
        <field name="category_id" ref="ci_categ_cotis_sal"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
result = categories.CI_COT_SAL
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- 3. COTISATIONS PATRONALES                                     -->
    <!--    D : 664100 Charges sociales nat. / 641xxx Taxes           -->
    <!--    C : 431xxx / 447xxx comptes tiers collecteurs             -->
    <!-- ============================================================ -->

    <!-- 5200 - Retraite CNPS (patronal) - 7.70% -->
    <record id="rule_ci_retraite_pat" model="hr.salary.rule">
        <field name="name">Régime de Retraite (patronal)</field>
        <field name="code">CI_RET_PAT</field>
        <field name="sequence" eval="30"/>
        <field name="category_id" ref="ci_categ_cotis_pat"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
smig = contract.company_id.l10n_ci_smig or 75000.0
brut = result_rules.CI_BRUT_TOTAL.total
