    <!-- 6. NET A PAYER — pas d'écriture comptable (ligne de résultat)-->
    <!-- ============================================================ -->

    <record id="rule_ci_net" model="hr.salary.rule">
        <field name="name">NET A PAYER</field>
        <field name="code">CI_NET</field>
        <field name="sequence" eval="99"/>
        <field name="category_id" ref="ci_categ_net"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Net = Brut + Cotisations salariales + Avantages + Déductions (avances)
brut = result_rules.CI_BRUT_TOTAL.total
cotis = result_rules.CI_TOT_COT_SAL.total  # Déjà négatif
avantages = categories.CI_AVT
deductions = categories.CI_DED             # Négatif (avances, prêts)
net = brut + cotis + avantages + deductions
# Arrondi aux 500 FCFA inférieurs (pratique courante CI)
result = int(net / 500) * 500
result_qty = 1.0
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="note">Net à payer = Brut - Cotisations + Avantages - Déductions, arrondi aux 500 FCFA.</field>
    </record>

