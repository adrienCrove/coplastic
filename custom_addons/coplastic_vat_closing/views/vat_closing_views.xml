<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coplastic_vat_closing_form" model="ir.ui.view">
        <field name="name">coplastic.vat.closing.form</field>
        <field name="model">coplastic.vat.closing</field>
        <field name="arch" type="xml">
            <form string="Clôture TVA">
                <header>
                    <button name="action_generate_move" type="object" string="Générer l'écriture de clôture"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_view_move" type="object" string="Voir l'écriture"
                            invisible="not move_id"/>
                    <button name="action_reset" type="object" string="Réinitialiser"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Comptes">
                            <field name="account_collected_id"/>
                            <field name="account_deductible_prefix"/>
                            <field name="account_due_id"/>
                            <field name="account_credit_carry_id"/>
                        </group>
                    </group>
                    <group string="Résultat de la période">
                        <group>
                            <field name="amount_collected" widget="monetary"/>
                            <field name="amount_deductible" widget="monetary"/>
                            <field name="amount_previous_credit" widget="monetary"/>
                        </group>
                        <group>
                            <field name="amount_net" widget="monetary"/>
                            <field name="amount_to_pay" widget="monetary" class="text-danger"/>
                            <field name="amount_credit_carry" widget="monetary" class="text-success"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="move_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_coplastic_vat_closing_tree" model="ir.ui.view">
        <field name="name">coplastic.vat.closing.tree</field>
        <field name="model">coplastic.vat.closing</field>
        <field name="arch" type="xml">
            <tree string="Déclarations TVA">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="amount_collected" widget="monetary"/>
                <field name="amount_deductible" widget="monetary"/>
                <field name="amount_to_pay" widget="monetary"/>
                <field name="amount_credit_carry" widget="monetary"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_coplastic_vat_closing" model="ir.actions.act_window">
        <field name="name">Clôture / Déclaration TVA</field>
        <field name="res_model">coplastic.vat.closing</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première déclaration TVA</p>
            <p>Calculez la TVA collectée, déductible et le crédit reporté sur une période,
               puis générez l'écriture de clôture (en brouillon).</p>
        </field>
    </record>

    <menuitem id="menu_coplastic_vat_closing"
              name="Clôture / Déclaration TVA"
              parent="account.menu_finance_reports"
              action="action_coplastic_vat_closing"
              sequence="90"/>

</odoo>
