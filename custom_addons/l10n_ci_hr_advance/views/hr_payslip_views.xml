<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Bouton intelligent sur le bulletin pour voir les avances -->
    <record id="hr_payslip_form_advance" model="ir.ui.view">
        <field name="name">hr.payslip.form.advance</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advances" type="object"
                        class="oe_stat_button" icon="fa-money">
                    <field name="advance_count" widget="statinfo" string="Avances"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
